# Copy this file to .env and fill in what you need. Never commit .env.
# After changing .env, run:  docker compose up -d --force-recreate

# Telegram bot tokens for projects that RECEIVE messages by polling.
# Each of these projects needs its OWN bot (create one per project with @BotFather).
# Leave a line empty until you build that project.
P4_BOT_TOKEN=
B02_BOT_TOKEN=
B04_BOT_TOKEN=
B05_BOT_TOKEN=
B09_BOT_TOKEN=
B13_BOT_TOKEN=
B14_BOT_TOKEN=
B15_BOT_TOKEN=
B16_BOT_TOKEN=
B18_BOT_TOKEN=
B19_BOT_TOKEN=
B20_BOT_TOKEN=
B22_BOT_TOKEN=

# b22 (Week 10+): the Qdrant version, from CONVENTIONS.md.
QDRANT_TAG=v1.19.2

# Optional: only if you set up a tunnel (see SETUP.md, "Optional: a public address").
# WEBHOOK_URL=https://your-tunnel-address.example/
