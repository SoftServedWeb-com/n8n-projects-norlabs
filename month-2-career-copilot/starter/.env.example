# Copy this file to .env and fill it in. .env is in .gitignore: never commit it.

# Milestone 1
OPENAI_API_KEY=

# Milestone 2: your GitHub username, and the repos to read commits from (comma-separated)
GITHUB_USER=
GITHUB_REPOS=
# Optional: a fine-grained, read-only token for a higher rate limit
GITHUB_TOKEN=

# Milestone 3: the folder your data files are in (Claude Desktop starts your server from elsewhere)
DATA_DIR=data

# Milestone 4
PORT=3000
